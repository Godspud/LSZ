#!/usr/bin/env python3
import sys
import os
import time
import shutil
import sqlite3
from pathlib import Path

RESET = "\033[0m"

# * cache
class Cache:
    # * Cache will handle all cache stuff
    def __init__(self, path: str, reset_time: float = 8 * 86400):
        # * time_till_redo_cache is when we descide that the row is to old and refresh it
        self.time_till_redo_cache = reset_time
        # * save on call by storing the usr ~ dir
        home = Path.home()
        # * path to the cache
        cache_path = Path(path)
        # * if cache path is relative then we absolute it
        if not cache_path.is_absolute():
            cache_path = home / ".cache" / "LSZ" / cache_path
        # * if cache file not exists make the LSZ dir and the cach file
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        self.path = str(cache_path)
        # * connect to db and make the tbl
        self.db = sqlite3.connect(cache_path, timeout=25.0) # 25s
        self.db.execute("""
CREATE TABLE IF NOT EXISTS dirsize_cache (
    path TEXT PRIMARY KEY,
    mtime REAL NOT NULL,
    size INTEGER NOT NULL,
    checked_at REAL NOT NULL
);""")

    def prune(self, older_than: float = None):
        """
        * prune removes all entries in the tbl older than the specified number
        """
        # * if older_than is provided
        if older_than != None:
            cutoff = time.time() - older_than
        else: # * else than use the default case
            cutoff = time.time() - self.time_till_redo_cache
        # * delete and commit
        self.db.execute("DELETE FROM dirsize_cache WHERE checked_at < ?", (cutoff,))
        self.db.commit()

    def clear(self):
        """
        * nukes the cache
        """
        self.db.execute("DELETE FROM dirsize_cache")
        self.db.commit()

    def put(self, path: str, size: int, modified_time: int, checked_at: float = None):
        """
        * adds a entry into the cache
        NOTE: you need to commit manually
        """
        # * gets the absolute path
        path = os.path.abspath(path)
        # * if a checked at time was not provided then use the current sys time
        if checked_at == None:
            checked_at = time.time()
        # * insert into the db
        self.db.execute(
            """INSERT OR REPLACE INTO dirsize_cache (path, size, mtime, checked_at) VALUES (?, ?, ?, ?)""",
            (path, size, modified_time, checked_at),
        )

    def puts(self, items: list[tuple[str, int, float, float]]):
        """
        * adds a list of entries into the cache then commits
        """
        # * insert then commit
        self.db.executemany(
            "INSERT OR REPLACE INTO dirsize_cache (path, size, mtime, checked_at) VALUES (?, ?, ?, ?)",
            items,
        )
        self.db.commit()

    def get(self, path: str, mtime: float):
        """
        * gets the entry from the path and if was last checked at longer than the time till redo cache OR cached mtime not eq to the mtime provided return none\
            else return cached size
        """
        # * get the abs path
        path = os.path.abspath(path)
        # * get the entry from the cache
        out = self.db.execute(
            """SELECT mtime, size, checked_at FROM dirsize_cache WHERE path = ?""",
            (path,),
        )
        out = out.fetchone()
        # * if invalid return none
        if not out:
            return None
        if (
            out[0] != mtime
            or (time.time() - out[2]) > self.time_till_redo_cache
        ):
            return None
        # * return cached size
        return out[1]

# * colors
# * get the colorss used in ls with fall back
ls_colors_str = os.environ.get("LS_COLORS", "di=01;34:ln=01;36:ex=01;32:fi=00")

class Color:
    # * the map for the colors
    MAP = dict(item.split("=", 1) for item in ls_colors_str.split(":") if "=" in item)

    @staticmethod
    def get(key, fallback="00"):
        # * get the key and return the code to change the terminanal color to that
        code = Color.MAP.get(key, fallback)
        return f"\033[{code}m"

def color_key(path, is_directory):
    """
    * gets the key for the color
    """
    if is_directory:
        return "di"

    try:
        # * if symlink return ln
        # * if executable reutrn ex
        if os.path.islink(path):
            return "ln"
        if os.access(path, os.X_OK):
            return "ex"

    except OSError:
        pass

    # * else return fi(file)
    return "fi"

def colored_name(path, is_directory, color):
    """
    * gets and returns the name for the dir but colored using color_key()
    """
    # * get the folder name
    name = os.path.basename(path)

    # * if color not enabled return name(no color)
    if not color:
        return name

    key = color_key(path, is_directory)

    # * return the name but colored
    return Color.get(key) + name + RESET


# * display
def cut(text, width):
    """
    * if too wide cut off and add a ...
    """
    if width <= 1:
        return text[: max(width, 0)]
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"

def scan_speed(state):
    """
    * gets the scanning speed
    """
    # * get the diff between the start and current time
    elapsed = time.monotonic() - state.start_time

    # * if time less than 0 then time is 0
    if elapsed <= 0:
        return 0

    # * return the speed
    return state.scanned_entries / elapsed

def display_path(path):
    """
    * gets the path to be displayed(no color only name)
    """
    # * get the full path and home dir
    path = os.path.abspath(path)
    home = os.path.expanduser("~")

    # * if the path is the home dir then return ~
    if path == home:
        return "~"

    # * else if the path starts with "$home"/ then return ~ + the rest of the path
    if path.startswith(home + os.sep):
        return "~" + path[len(home) :]

    return path

class ScanState:
    # * this stores the data we use to find speed and the extra data we display with the progress bar
    def __init__(self, top_total):
        self.files = 0
        self.dirs = 0
        self.bytes = 0

        self.current = ""

        self.scanned_entries = 0

        self.start_time = time.monotonic()

        self.top_done = 0
        self.top_total = top_total

        self.results = []

        self.discovery_lines = []

        # * this is how many discoveries before we print
        # * if printQ >= threshold then we print and reset printQ
        # * cos print is very slow
        self.printQ = 0

class Normal:
    # * class for displaying the progress bar when u do lsz
    def __init__(self, color=False, unit_type=None, unit=None):
        # * store weather color is on or not and the units
        self.color = color
        self.unit_type = unit_type
        self.unit = unit

    def update(self, state):
        # * this exists so we can call state.update() w/o worrying which state were using
        self.print_progress(state)

    def print_progress(self, state):
        # * calculate progress if no dirs then 100% else divide done by total
        if state.top_total == 0:
            percent = 100.0
        else:
            percent = state.top_done / state.top_total * 100

        # * width of the bar
        width = 30
        # * int to round down
        filled = int(width * percent / 100)
        # * get the bar to print
        bar = "█" * filled + "░" * (width - filled)

        print(
            # * print the bar and percent making sure that 1dp max
            f"\r{bar} {percent:5.1f}%" f"  Top-level "
            # * how much of the top levl weve done
            f"{state.top_done}/{state.top_total}"
            # * the speed
            f"  {human_speed(scan_speed(state))}"
            # * the amt of files and dirs
            f"  Files {state.files:,}"
            f"  Dirs {state.dirs:,}"
            # * and the total size
            f"  Size {human_size(state.bytes, self.unit_type, self.unit)}",
            # * no newline and force
            end="",
            flush=True,
        )

class Fancy:
    # * Ooh fancy class
    def __init__(self, color, discovery_lines=None, unit_type=None, unit=None,threshold=1000):
        # * color storse weather color is on
        self.color = color
        # * the data in the discovery lines displayed
        self.discovery_lines = []
        # * unit and force unit
        self.unit_type = unit_type
        self.unit = unit
        # * count for the discoveries we have currently
        self.printQ = 0
        # * no of discoverise before printing
        self.threshold = threshold
        # * if discovery_lines not provided then use the terminal size divided by 10
        if discovery_lines == None:
            self.discovery_line = max(1, int(shutil.get_terminal_size().lines * 0.1))
        else:
            self.discovery_line = discovery_lines
        # * terminal height is the discovery lines + 9
        self.terminal_height = self.discovery_line + 9
        # * append a empty str that is no a dir
        for _ in range(self.discovery_line):
            self.discovery_lines.append(("", False))

    def update(self, state):
        # * update() so we can call ui.update() regradless
        # * if the current print is larger or eq to the threshold then print and reset
        # * else add 1
        if self.printQ >= self.threshold:
            self.print_progress(state)
            self.printQ = 0
        else:
            self.printQ += 1

    def discover(self, path, is_directory):
        # * append the file js found and if to many lines then pop the first one
        self.discovery_lines.append((display_path(path), is_directory))

        if len(self.discovery_lines) > self.discovery_line:
            self.discovery_lines.pop(0)

    def print_progress(self, state):
        # * Move to beginning of dashboard
        print(f"\033[{self.terminal_height-1}A", end="")
        # * Erase everything below cursor.
        print("\033[0J", end="")
        # * if the dirs to count is 0 were done
        if state.top_total == 0:
            percent = 100.0
        else:
            percent = state.top_done / state.top_total * 100

        # * width of the progress bar
        width = 30
        # * round down to a whole no
        filled = int(width * percent / 100)
        # * build the bar
        bar = "█" * filled + "░" * (width - filled)
        # * get the left to right size of the terminal
        cols = shutil.get_terminal_size().columns
        scanning_line = f"Scanning {display_path(state.current)}"
        # * cut the path that will be displayed as we discover and display 
        print(cut(scanning_line, cols))

        # * print the percentage of the bar to 1db
        print(f"{bar} {percent:5.1f}%")
        print(
            f"Top-level "
            # * the top done over the total
            f"{state.top_done}/{state.top_total}"
            # * scan speed
            f"    {human_speed(scan_speed(state))}"
        )
        # * all the files and dirs and the size
        print(f"Files {state.files:,}")
        print(f"Dirs  {state.dirs:,}")
        print(f"Size  {human_size(state.bytes, self.unit_type, self.unit)}")
        print()
        # * print the discovries
        print("Recently discovered")
        self.print_discoveries()

    def print_discoveries(self):
        # * iterate over every discovery and print them with color
        for path, is_directory in self.discovery_lines:
            if self.color:
                print(colored_name(path, is_directory, True))

            else:
                print(path)

# * files
def scan_entry(entry: os.DirEntry, state, fancy=False, ui=None, cache: Cache = None):
    # * get filepath(the last one aft the /) and add to the amount of scanned entries
    state.current = os.path.abspath(entry.path)
    state.scanned_entries += 1
    try:
        # * symlink discover and return
        if entry.is_symlink():
            # * get symlink size and update
            try:
                size = entry.stat(follow_symlinks=False).st_size
            except OSError:
                size = 0

            state.files += 1
            state.bytes += size

            if fancy:
                ui.discover(entry.path, False)
                ui.update(state)

            return size, False

        # * dir discover and recurse
        if entry.is_dir(follow_symlinks=False):
            # * get mtime and check for cached size
            try:
                mtime = entry.stat(follow_symlinks=False).st_mtime
                cached_size = cache.get(entry.path, mtime) if cache else None
            except OSError:
                mtime = None
                cached_size = None
            if cached_size != None:
                state.dirs += 1
                state.bytes += cached_size
                if fancy:
                    ui.discover(entry.path, True)
                    ui.update(state)
                return cached_size, True
            # * add to the dirs then recurese and update the cache
            state.dirs += 1
            total_size = 0
            try:
                with os.scandir(entry.path) as entries:
                    for child in entries:
                        child_size, _ = scan_entry(child, state, fancy, ui, cache)
                        total_size += child_size
                size = total_size
                path = entry.path
                if cache and mtime != None:
                    cache.put(path, size, mtime)
            except OSError:
                pass
            except sqlite3.OperationalError:
                print("lsz: please wait for a second and try again another instance is running")
                sys.exit(2)
            # * add to total size and update ui
            state.bytes += total_size
            if fancy:
                ui.discover(entry.path, True)
                ui.update(state)
            return total_size, True

        # * normal file and get size
        try:
            size = entry.stat(follow_symlinks=False).st_size
        except OSError:
            size = 0

        # * update the state and update ui
        state.files += 1
        state.bytes += size
        if fancy:
            ui.discover(entry.path, False)
            ui.update(state)

        return size, False

    except OSError:
        return 0, False

# * cmd line
def print_help():
    # * prints the help text
    # NOTE: update every time new cli stuff is added
    print("""Usage: lsz [OPTIONS] [DIRECTORY]

Recursively report directory and file sizes, sorted largest first.

Options:
  -f, --fancy                           Show a live dashboard while scanning
  -C, --no-cache                        Skip the cache entirely for this run
  -c, --color                           Enable colored output
      --no-color                        Disable colored output
      --lines="$no_of_lines"            Number of discovery lines shown in fancy mode
      --cache-file="$cache_file_name"   Use a custom cache filename (default: LSZ.sqlite)
      --reset-time="$time_till_reset"   Cache reset time in seconds (default: 691200, 8 days)
      --clean-cache                     Wipe the entire cache and exit
      --prune-cache                     Delete cache entries older than the reset time and exit
      --si                              Show sizes in decimal (1000-based) instead of binary (1024-based)
      --unit="$unit"                    Force one unit for every size (B, kB, KB, MB, GB, TB)
  -h, --help                            Show this help message and exit

  --clean-cache and --prune-cache conflict with --no-cache.
  --si and --unit conflict with each other.

  DIRECTORY defaults to the current directory.""")

def parse_args(argv):
    # * these are the deaults
    fancy = False
    color = False
    lines = None
    clean_cache = False
    prune_cache = False
    use_cache = "LSZ.sqlite"
    reset_time = None
    error = False
    unit_type = False
    unit = None

    directory = "."

    for arg in argv[1:]:
        # * this is the same pattern over and over again
        if arg == "--help" or arg == "-h":
            print_help()
            sys.exit(0)

        if arg == "--lines" or arg == "--lines=":
            print("lsz: requies amount of discovery lines to show", file=sys.stderr)
            error = True
            continue

        if arg == "--cache-file" or arg == "--cache-file=":
            print("lsz: cache file required with --cache-file", file=sys.stderr)
            error = True
            continue

        if arg == "--reset-time" or arg == "--reset-time=":
            print("lsz: --reset-time requires a value", file=sys.stderr)
            error = True
            continue

        if arg.startswith("--unit="):
            unit = arg.split("=", 1)[1]
            if not unit:
                print("lsz: --unit requires a value", file=sys.stderr)
                error = True
                continue
            if unit[0] == '"' and unit[-1] == '"':
                unit = unit[1:-1]
            elif unit[0] == "'" and unit[-1] == "'":
                unit = unit[1:-1]
            valid_units = {"B", "KB", "MB", "GB", "TB", "kB"}
            if unit not in valid_units:
                print(f"lsz: invalid unit '{unit}'\nvalid units: B kB KB MB GB TB", file=sys.stderr)
                error = True
            continue

        if arg.startswith("--lines="):
            try:
                lines = int(arg.split("=", 1)[1])
            except ValueError:
                print(f"lsz: invalid value for --lines", file=sys.stderr)
                sys.exit(2)
            continue

        if arg.startswith("--cache-file="):
            use_cache = arg.split("=", 1)[1]
            if use_cache[0] == '"' and use_cache[-1] == '"':
                use_cache = use_cache[1:-1]
            elif use_cache[0] == "'" and use_cache[-1] == "'":
                use_cache = use_cache[1:-1]
            continue

        if arg.startswith("--reset-time="):
            try:
                reset_time = int(arg.split("=", 1)[1])
            except ValueError:
                print(f"lsz: invalid value for --reset-time", file=sys.stderr)
                sys.exit(2)
            continue

        if arg == "--si":
            unit_type = True
            continue

        if arg == "--prune-cache":
            prune_cache=True
            continue

        if arg == "--clean-cache":
            clean_cache = True
            continue

        if arg == "--no-cache":
            use_cache = None
            continue

        if arg == "--fancy":
            fancy = True
            continue

        if arg == "--color":
            color = True
            continue

        if arg == "--no-color":
            color = False
            continue

        if arg.startswith("-") and arg != "-":
            for flag in arg[1:]:
                if flag == "h":
                    print_help()
                    sys.exit(0)
                if flag == "f":
                    fancy = True

                elif flag == "C":
                    use_cache = None

                elif flag == "c":
                    color = True

                else:
                    print(f"lsz: unknown option " f"'-{flag}'", file=sys.stderr)
                    sys.exit(2)

        else:
            directory = arg
            break

    if unit_type and unit != None:
        # * this isto prevent the kb not found crash
        print("lsz: cannot use --unit and --si together")
        error = True

    if error:
        sys.exit(2)

    return fancy, color, directory, lines, use_cache, clean_cache, prune_cache, reset_time, unit_type, unit

# * output
def sort_results(results):
    # * sorts the result from big to small
    results.sort(key=lambda x: (not x[2], -x[1]))

def print_results(results, color, unit_type, unit):
    if not results:
        return

    # * get the name for every path
    names = [os.path.basename(path) for path, _, _ in results]
    # * get the longest so that the output is ordered and so theat the size is consistant
    longest = max(len(name) for name in names)
    for path, size, is_directory in results:
        # * print the name
        raw_name = os.path.basename(path)
        name = colored_name(path, is_directory, color)
        # * add pading
        padding = " " * (longest - len(raw_name) + 2)
        # * print the name and the size
        print(name + padding + human_size(size, unit_type, unit))

def human_size(size, units=False, force_unit=None):
    # * the units and their sizes
    lookup = (
        {"TB": 1000**4, "GB": 1000**3, "MB": 1000**2, "kB": 1000, "B": 1}
        if units
        else {"TB": 1024**4, "GB": 1024**3, "MB": 1024**2, "KB": 1024, "B": 1}
    )

    if force_unit:
        # * return the size of the unit as the unit
        try:
            return f"{size / lookup[force_unit]:.1f}{force_unit}"
        except KeyError:
            print("lsz: invalid unit for size")
            sys.exit(2)

    # * loop till correct
    for unit, divisor in lookup.items():
        if size >= divisor:
            return f"{size / divisor:.1f}{unit}"

    # * fallback
    return f"{size}B"

def human_speed(value, force_unit=None):
    # * the size per second
    return f"{human_size(value, True, force_unit=force_unit)}/s"

# ! entry point
def main():
    # * get the args from the cli
    fancy, color, directory, lines, cache, clean_cache, prune_cache, reset_time, unit_type, unit = parse_args(
        sys.argv
    )
    # * catch the invalid combos
    # TODO: move into parse_args
    if (clean_cache or prune_cache) and cache == None:
        print("lsz: --clean-cache/--prune-cache and --no-cache can't be used together", file=sys.stderr)
        sys.exit(2)
    if cache != None:
        if reset_time != None:
            cache = Cache(cache, reset_time)
        else:
            cache = Cache(cache)
    # * prune and clean cache
    if prune_cache:
        cache.prune()
        print("cache prune sucess")
        sys.exit(0)
    if clean_cache:
        cache.clear()
        print("cache clean sucess")
        sys.exit(0)

    # * get the contents of the directory passed to lsz
    directory = os.path.abspath(os.path.expanduser(directory))
    if not os.path.isdir(directory):
        print(f"lsz: '{directory}' " f"is not a directory", file=sys.stderr)
        sys.exit(1)

    # * get contents of the dir
    try:
        entries = list(os.scandir(directory))
    except OSError as e:
        print(f"lsz: cannot read " f"'{display_path(directory)}': {e}", file=sys.stderr)
        sys.exit(1)

    # * init state
    state = ScanState(len(entries))

    # * assign ui for ui.update()
    if fancy:
        ui = Fancy(color, lines, unit_type, unit)
        print("\n" * (ui.discovery_line + 7))
    else:
        ui = Normal(color, unit_type, unit)

    # * iterate over every top level entry and scan it then update
    for entry in entries:
        size, is_directory = scan_entry(entry, state, fancy, ui, cache)
        if cache:
            cache.db.commit()
        state.results.append((os.path.abspath(entry.path), size, is_directory))
        state.top_done += 1
        ui.update(state)

    # * show results
    print()
    sort_results(state.results)
    if fancy:
        print(f"\033[{ui.discovery_line+9}A", end="")
        print(f"\033[J", end="")
    else:
        print(f"\033[2A")
        print(f"\033[J", end="")
    print_results(state.results, color, unit_type, unit)

if __name__ == "__main__":
    main()
