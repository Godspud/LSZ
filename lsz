#!/usr/bin/env python3
import sys
import os
import time
import shutil
import sqlite3
from pathlib import Path

RESET = "\033[0m"

class Cache:

    def __init__(self, path: str, reset_time: float = 8 * 86400):
        self.time_till_redo_cache = reset_time
        home = Path.home()
        cache_path = Path(path)
        if not cache_path.is_absolute():
            cache_path = home / ".cache" / "LSZ" / cache_path

        cache_path.parent.mkdir(parents=True, exist_ok=True)
        self.path = str(cache_path)
        self.db = sqlite3.connect(cache_path, timeout=25.0) # 25s
        self.db.execute("""
CREATE TABLE IF NOT EXISTS dirsize_cache (
    path TEXT PRIMARY KEY,
    mtime REAL NOT NULL,
    size INTEGER NOT NULL,
    checked_at REAL NOT NULL
);""")

    def prune(self, older_than: float = None):
        if older_than != None:
            cutoff = time.time() - older_than
        else:
            cutoff = time.time() - self.time_till_redo_cache
        self.db.execute("DELETE FROM dirsize_cache WHERE checked_at < ?", (cutoff,))
        self.db.commit()

    def clear(self):
        self.db.execute("DELETE FROM dirsize_cache")
        self.db.commit()

    def put(self, path: str, size: int, modified_time: int, checked_at: float = None):
        path = os.path.abspath(path)
        if checked_at == None:
            checked_at = time.time()
        self.db.execute(
            """INSERT OR REPLACE INTO dirsize_cache (path, size, mtime, checked_at) VALUES (?, ?, ?, ?)""",
            (path, size, modified_time, checked_at),
        )

    def puts(self, items: list[tuple[str, int, float, float]]):
        self.db.executemany(
            "INSERT OR REPLACE INTO dirsize_cache (path, size, mtime, checked_at) VALUES (?, ?, ?, ?)",
            items,
        )
        self.db.commit()

    def get(self, path: str, mtime):
        path = os.path.abspath(path)
        out = self.db.execute(
            """SELECT mtime, size, checked_at FROM dirsize_cache WHERE path = ?""",
            (path,),
        )
        out = out.fetchone()
        if not out:
            return None
        cached_mtime, cached_size, checked_at = out
        if (
            cached_mtime != mtime
            or (time.time() - checked_at) > self.time_till_redo_cache
        ):
            return None
        return cached_size

ls_colors_str = os.environ.get("LS_COLORS", "di=01;34:ln=01;36:ex=01;32:fi=00")

class Color:
    MAP = dict(item.split("=", 1) for item in ls_colors_str.split(":") if "=" in item)

    @staticmethod
    def get(key, fallback="00"):
        code = Color.MAP.get(key, fallback)
        return f"\033[{code}m"

def color_key(path, is_directory):
    if is_directory:
        return "di"

    try:
        if os.path.islink(path):
            return "ln"
        if os.access(path, os.X_OK):
            return "ex"

    except OSError:
        pass

    return "fi"

def colored_name(path, is_directory, color):
    name = os.path.basename(path)

    if not color:
        return name

    key = color_key(path, is_directory)

    return Color.get(key) + name + RESET

def human_size(size):
    if size < 1000:
        return f"{size}B"

    if size < 1000**2:
        return f"{size / 1000:.1f}KB"

    if size < 1000**3:
        return f"{size / 1000**2:.1f}MB"

    if size < 1000**4:
        return f"{size / 1000**3:.1f}GB"

    return f"{size / 1000**4:.1f}TB"


def human_speed(value):
    if value < 1000:
        return f"{value:.0f}B/s"

    if value < 1000**2:
        return f"{value / 1000:.1f}kB/s"

    if value < 1000**3:
        return f"{value / 1000**2:.1f}MB/s"

    return f"{value / 1000**3:.1f}GB/s"


def scan_speed(state):
    elapsed = time.monotonic() - state.start_time

    if elapsed <= 0:
        return 0

    return state.scanned_entries / elapsed


def display_path(path):
    path = os.path.abspath(path)
    home = os.path.expanduser("~")

    if path == home:
        return "~"

    if path.startswith(home + os.sep):
        return "~" + path[len(home) :]

    return path


def sort_results(results):
    results.sort(key=lambda x: (not x[2], -x[1]))


class ScanState:
    def __init__(self, top_total):
        self.files = 0
        self.dirs = 0
        self.bytes = 0

        self.current = ""

        self.scanned_entries = 0

        self.start_time = time.monotonic()

        self.top_done = 0
        self.top_total = top_total

        self.results = []

        self.discovery_lines = []

        self.printQ = 0


def print_results(results, color):
    if not results:
        return

    names = [os.path.basename(path) for path, _, _ in results]
    longest = max(len(name) for name in names)
    for path, size, is_directory in results:
        raw_name = os.path.basename(path)
        name = colored_name(path, is_directory, color)
        padding = " " * (longest - len(raw_name) + 2)
        print(name + padding + human_size(size))


def scan_entry(entry: os.DirEntry, state, fancy=False, ui=None, cache: Cache = None):
    # get filepath(the last one aft the /)
    state.current = os.path.abspath(entry.path)
    state.scanned_entries += 1
    try:
        # symlink discover and return
        if entry.is_symlink():
            try:
                size = entry.stat(follow_symlinks=False).st_size

            except OSError:
                size = 0

            state.files += 1
            state.bytes += size

            if fancy:
                ui.discover(entry.path, False)
                ui.update(state)

            return size, False
        
        # dir discover and recurse
        if entry.is_dir(follow_symlinks=False):
            try:
                mtime = entry.stat(follow_symlinks=False).st_mtime
                cached_size = cache.get(entry.path, mtime) if cache else None
            except OSError:
                mtime = None
                cached_size = None
            if cached_size != None:
                state.dirs += 1
                state.bytes += cached_size
                if fancy:
                    ui.discover(entry.path, True)
                    ui.update(state)
                return cached_size, True
            state.dirs += 1
            total_size = 0
            try:
                with os.scandir(entry.path) as entries:
                    for child in entries:
                        child_size, _ = scan_entry(child, state, fancy, ui, cache)
                        total_size += child_size
                size = total_size
                path = entry.path
                if cache and mtime != None:
                    cache.put(path, size, mtime)
            except OSError:
                pass
            except sqlite3.OperationalError:
                print("lsz: please wait for a second another instance is running")
                sys.exit(2)
            state.bytes += total_size
            if fancy:
                ui.discover(entry.path, True)
                ui.update(state)
            return total_size, True

        # normal file and get size
        try:
            size = entry.stat(follow_symlinks=False).st_size

        except OSError:
            size = 0

        state.files += 1
        state.bytes += size
        if fancy:
            ui.discover(entry.path, False)
            ui.update(state)

        return size, False

    except OSError:
        return 0, False


class Normal:
    def __init__(self, color):
        self.color = color

    def update(self, state):
        self.print_progress(state)

    def print_progress(self, state):
        if state.top_total == 0:
            percent = 100.0
        else:
            percent = state.top_done / state.top_total * 100

        width = 30
        filled = int(width * percent / 100)
        bar = "█" * filled + "░" * (width - filled)

        print(
            f"\r{bar} {percent:5.1f}%"
            f"  Top-level "
            f"{state.top_done}/{state.top_total}"
            f"  {human_speed(scan_speed(state))}"
            f"  Files {state.files:,}"
            f"  Dirs {state.dirs:,}"
            f"  Size {human_size(state.bytes)}",
            end="",
            flush=True,
        )


def cut(text, width):
    if width <= 1:
        return text[: max(width, 0)]
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


class Fancy:
    def __init__(self, color, discovery_lines=None, threshold=1000):
        self.color = color
        self.discovery_lines = []
        self.printQ = 0
        self.threshold = threshold
        if discovery_lines == None:
            self.discovery_line = max(1, int(shutil.get_terminal_size().lines * 0.1))
        else:
            self.discovery_line = discovery_lines
        self.terminal_height = self.discovery_line + 9
        for _ in range(self.discovery_line):
            self.discovery_lines.append(("", False))

    def update(self, state):
        if self.printQ >= self.threshold:
            self.print_progress(state)
            self.printQ = 0
        else:
            self.printQ += 1

    def discover(self, path, is_directory):
        self.discovery_lines.append((display_path(path), is_directory))

        if len(self.discovery_lines) > self.discovery_line:
            self.discovery_lines.pop(0)

    def print_progress(self, state):
        # Move to beginning of dashboard
        print(f"\033[{self.terminal_height-1}A", end="")
        # Erase everything below cursor.
        print("\033[0J", end="")
        if state.top_total == 0:
            percent = 100.0

        else:
            percent = state.top_done / state.top_total * 100

        width = 30
        filled = int(width * percent / 100)
        bar = "█" * filled + "░" * (width - filled)
        cols = shutil.get_terminal_size().columns
        scanning_line = f"Scanning {display_path(state.current)}"
        print(cut(scanning_line, cols))

        print(f"{bar} {percent:5.1f}%")
        print(
            f"Top-level "
            f"{state.top_done}/{state.top_total}"
            f"    {human_speed(scan_speed(state))}"
        )
        print(f"Files {state.files:,}")
        print(f"Dirs  {state.dirs:,}")
        print(f"Size  {human_size(state.bytes)}")
        print()
        print("Recently discovered")
        self.print_discoveries()

    def print_discoveries(self):
        for path, is_directory in self.discovery_lines:
            if self.color:
                print(colored_name(path, is_directory, True))

            else:
                print(path)


def parse_args(argv):
    fancy = False
    color = False
    lines = None
    clean_cache = False
    prune_cache = False
    use_cache = "LSZ.sqlite"
    reset_time = None
    error = False

    directory = "."

    for arg in argv[1:]:
        if arg == "--lines":
            continue

        if arg == ("--cache-file"):
            print("lsz: cache file required with --cache-file", file=sys.stderr)
            error = True
            continue

        if arg == ("--reset-time"):
            print("lsz: --reset-time requires a value", file=sys.stderr)
            error = True
            continue

        if arg.startswith("--lines="):
            try:
                lines = int(arg.split("=", 1)[1])
            except ValueError:
                print(f"lsz: invalid value for --lines", file=sys.stderr)
                sys.exit(2)
            continue

        if arg.startswith("--cache-file="):
            use_cache = arg.split("=", 1)[1]
            if use_cache[0] == '"' and use_cache[-1] == '"':
                use_cache = use_cache[1:-1]
            elif use_cache[0] == "'" and use_cache[-1] == "'":
                use_cache = use_cache[1:-1]
            continue

        if arg.startswith("--reset-time="):
            try:
                reset_time = int(arg.split("=", 1)[1])
            except ValueError:
                print(f"lsz: invalid value for --reset-time", file=sys.stderr)
                sys.exit(2)
            continue

        if arg == "--prune-cache":
            prune_cache=True
            continue

        if arg == "--clean-cache":
            clean_cache = True
            continue

        if arg == "--no-cache":
            use_cache = None
            continue

        if arg == "--fancy":
            fancy = True
            continue

        if arg == "--color":
            color = True
            continue

        if arg == "--no-color":
            color = False
            continue

        if arg.startswith("-") and arg != "-":
            for flag in arg[1:]:
                if flag == "f":
                    fancy = True

                elif flag == "C":
                    use_cache = None

                elif flag == "c":
                    color = True

                else:
                    print(f"lsz: unknown option " f"'-{flag}'", file=sys.stderr)
                    sys.exit(2)

        else:
            directory = arg
            break

    if error:
        sys.exit(2)

    return fancy, color, directory, lines, use_cache, clean_cache, prune_cache, reset_time


def main():
    fancy, color, directory, lines, cache, clean_cache, prune_cache, reset_time = parse_args(
        sys.argv
    )
    if (clean_cache or prune_cache) and cache == None:
        print("lsz: --clean-cache/--prune-cache and --no-cache can't be used together", file=sys.stderr)
        sys.exit(2)

    if cache != None:
        if reset_time != None:
            cache = Cache(cache, reset_time)
        else:
            cache = Cache(cache)
    if prune_cache:
        cache.prune()
        print("cache prune sucess")
        sys.exit(0)
    if clean_cache:
        cache.clear()
        print("cache clean sucess")
        sys.exit(0)

    directory = os.path.abspath(os.path.expanduser(directory))
    if not os.path.isdir(directory):
        print(f"lsz: '{directory}' " f"is not a directory", file=sys.stderr)
        sys.exit(1)

    try:
        entries = list(os.scandir(directory))

    except OSError as e:
        print(f"lsz: cannot read " f"'{display_path(directory)}': {e}", file=sys.stderr)
        sys.exit(1)

    state = ScanState(len(entries))

    if fancy:
        ui = Fancy(color, lines)
        print("\n" * (ui.discovery_line + 7))

    else:
        ui = Normal(color)

    for entry in entries:
        size, is_directory = scan_entry(entry, state, fancy, ui, cache)
        if cache:
            cache.db.commit()
        state.results.append((os.path.abspath(entry.path), size, is_directory))
        state.top_done += 1
        ui.update(state)

    if fancy:
        print()

    else:
        print()
    sort_results(state.results)
    if fancy:
        print(f"\033[{ui.discovery_line+9}A", end="")
        print(f"\033[J", end="")
    else:
        print(f"\033[2A")
        print(f"\033[J", end="")
    print_results(state.results, color)


if __name__ == "__main__":
    main()
